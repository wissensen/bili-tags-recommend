# 本地开发环境变量
# 复制本文件填入真实值；两个文件都已被 .gitignore 排除，不会提交：
#   - .dev.vars    → 供 wrangler / pnpm cf:dev（Cloudflare 运行时）读取
#   - .env.local   → 供 pnpm dev（next dev，纯 Next.js）读取
# 用 pnpm dev 开发时必须有 .env.local，否则 AI 润色会因读不到密钥报 AI_NOT_CONFIGURED。
# 线上部署改用：pnpm wrangler secret put <NAME>

# 阿里云百炼 API Key
DASHSCOPE_API_KEY=your-dashscope-api-key
# 阿里云百炼业务空间 ID（用于拼接 MaaS 端点）
DASHSCOPE_WORKSPACE_ID=ws-xxxxxxxx
